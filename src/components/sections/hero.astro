---
// Hero.astro
---

<div class="hero-section">
    <!-- VIDEO DE YOUTUBE: de fondo y en silencio; al hacer click se activa el sonido -->
    <div id="video-container">
        <div id="yt-player"></div>
    </div>
    <button id="video-sound-toggle" class="sound-toggle" aria-label="Activar sonido" aria-pressed="false">
        <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        <svg class="icon-sound" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
    </button>
</div>

<style>
    .hero-section {
        position: relative;
        height: 100vh;
        width: 100%;
        overflow: hidden;
        background-color: black;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: -20vh;
    }

    #video-container {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    /* El iframe cubre todo el hero (como object-fit: cover) manteniendo 16:9 */
    #video-container iframe {
        position: absolute;
        top: 50%;
        left: 50%;
        width: max(100vw, 177.78vh);
        height: max(56.25vw, 100vh);
        transform: translate(-50%, -50%);
        border: 0;
    }

    /* Capa transparente encima del video que recibe el click */
    .hero-section::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .sound-toggle {
        position: absolute;
        right: 20px;
        bottom: calc(20vh + 20px); /* compensa el margin-bottom negativo del hero */
        z-index: 5;
        width: 48px;
        height: 48px;
        padding: 12px;
        border: 0;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: white;
        cursor: pointer;
    }
    .sound-toggle svg { width: 100%; height: 100%; display: block; }
    .sound-toggle .icon-sound { display: none; }
    .sound-toggle[aria-pressed="true"] .icon-sound { display: block; }
    .sound-toggle[aria-pressed="true"] .icon-muted { display: none; }

    .hero-content {
        position: relative;
        z-index: 10;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
    }

    .hero-logo {
        width: 80%;
        max-width: 600px;
        height: auto;
        margin-bottom: 20px;
    }
     .hero-dibujo {
        width: 80%;
        max-width: 600px;
        height: auto;
        margin-bottom: 20px;
    }

    .btn-hero {
        padding: 20px 40px;
        font-size: 1.2rem;
        background-color: var(--c-rojo);
        color: white;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        transition: transform 0.2s;
    }
    .btn-hero:hover { 
        transform: scale(1.05); 
        background: white; 
        color: black; }

    @media (max-width: 768px) {
        .hero-content {
            padding: 0vh 20px;
        }
        .hero-logo {
            width: 60%;
            max-width: none;
        }
        .hero-dibujo {
            width: 100%;
            max-width: 120vw;
        }   
    }
</style>

<script>
    const VIDEO_ID = '1yJYjwSGGhc';
    const section = document.querySelector('.hero-section');
    const toggle = document.getElementById('video-sound-toggle');
    let player;

    function setUi(soundOn) {
        toggle.setAttribute('aria-pressed', String(soundOn));
    }

    function toggleSound() {
        if (!player || !player.isMuted) return;
        if (player.isMuted()) {
            player.unMute();
            player.setVolume(100);
            player.playVideo();
            setUi(true);
        } else {
            player.mute();
            setUi(false);
        }
    }

    // Click en cualquier parte del video (o en el botón) alterna el sonido
    section.addEventListener('click', toggleSound);

    function createPlayer() {
        player = new window.YT.Player('yt-player', {
            videoId: VIDEO_ID,
            playerVars: {
                autoplay: 1,
                mute: 1,
                loop: 1,
                playlist: VIDEO_ID, // necesario para que loop funcione
                controls: 0,
                modestbranding: 1,
                rel: 0,
                playsinline: 1,
                disablekb: 1,
                iv_load_policy: 3,
            },
            events: {
                onReady: (e) => { e.target.mute(); e.target.playVideo(); },
            },
        });
    }

    if (window.YT && window.YT.Player) {
        createPlayer();
    } else {
        window.onYouTubeIframeAPIReady = createPlayer;
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(tag);
    }
</script>
